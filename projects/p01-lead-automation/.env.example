# Optional local overrides. Copy to .env (git-ignored) only if you need to change something.
# compose.yaml already has local-only defaults for everything below.

# Host ports (bound to 127.0.0.1)
POSTGRES_PORT=5432
API_PORT=8000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
N8N_PORT=5678

# If you change the database credentials or the Mailpit ports, also set TEST_DATABASE_URL,
# TEST_MAILPIT_URL (e.g. http://127.0.0.1:8025) or TEST_MAILPIT_SMTP_PORT for the test suite.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# TEST_DATABASE_URL=

# AC-2.7 (`make smoke-live`): your Anthropic API key. Keep it only in .env, which git ignores.
# The compose stack keeps using the fake provider; only `make smoke-live` calls the real API,
# and it sends synthetic test data only.
# ANTHROPIC_API_KEY=
