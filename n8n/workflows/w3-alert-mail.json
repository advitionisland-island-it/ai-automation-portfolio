{
  "id": "P01W3AlertMail00",
  "name": "W3 alert mail",
  "nodes": [
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000301",
      "name": "When a workflow fails",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -120
      ],
      "parameters": {}
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000302",
      "name": "Alert: workflow failed",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        260,
        -120
      ],
      "parameters": {
        "fromEmail": "n8n@sales-ops.example",
        "toEmail": "alerts@sales-ops.example",
        "subject": "=n8n workflow failed: {{ $json.workflow.name }}",
        "emailFormat": "text",
        "text": "=An n8n workflow failed.\n\nWorkflow: {{ $json.workflow.name }}\nFailed node: {{ $json.execution.lastNodeExecuted || 'unknown' }}\nError: {{ ($json.execution.error || {}).message || 'unknown' }}\nExecution: {{ $json.execution.id || 'not saved' }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "P01MailpitSmtp00",
          "name": "Mailpit SMTP (local, no login)"
        }
      }
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000303",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000304",
      "name": "Claim alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        260,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/alerts/claim?limit=20",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000305",
      "name": "Alert: lead failed",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        520,
        120
      ],
      "parameters": {
        "fromEmail": "n8n@sales-ops.example",
        "toEmail": "alerts@sales-ops.example",
        "subject": "=Lead {{ $json.kind }}: {{ $json.company || $json.lead_id }}",
        "emailFormat": "text",
        "text": "=A lead needs a person.\n\nAlert: {{ $json.kind }}\nCompany: {{ $json.company || 'not given' }}\nStep: {{ $json.job_kind }}, after {{ $json.attempts }} attempt(s)\nReason: {{ $json.reason }}\n\nLead: {{ $json.lead_url }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "P01MailpitSmtp00",
          "name": "Mailpit SMTP (local, no login)"
        }
      }
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000306",
      "name": "Mark alert delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        780,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/v1/alerts/' + $('Claim alerts').item.json.id + '/delivered' }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
  "connections": {
    "When a workflow fails": {
      "main": [
        [
          {
            "node": "Alert: workflow failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 10 seconds": {
      "main": [
        [
          {
            "node": "Claim alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim alerts": {
      "main": [
        [
          {
            "node": "Alert: lead failed",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Alert: lead failed": {
      "main": [
        [
          {
            "node": "Mark alert delivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false
}
