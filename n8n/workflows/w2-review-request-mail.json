{
  "id": "P01W2ReviewMail0",
  "name": "W2 review request mail",
  "nodes": [
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000201",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000202",
      "name": "Claim review requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/review-requests/claim?limit=20",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000203",
      "name": "Ask for a review",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "fromEmail": "n8n@sales-ops.example",
        "toEmail": "reviewers@sales-ops.example",
        "subject": "=Review needed: {{ $json.company || 'unknown company' }} ({{ $json.tier }}, score {{ $json.score }})",
        "emailFormat": "text",
        "text": "=A follow-up draft is waiting for your approval.\n\nCompany: {{ $json.company || 'not given' }}\nAssessment: {{ $json.tier }} lead, score {{ $json.score }}\n{{ $json.summary }}\n\nDraft {{ $json.draft_version }}: {{ $json.draft_subject }}\n\nReview, edit, approve or reject it here:\n{{ $json.review_url }}\n\nNothing is sent to the lead until a person approves this exact text.",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "P01MailpitSmtp00",
          "name": "Mailpit SMTP (local, no login)"
        }
      }
    },
    {
      "id": "5b0e1c6e-7a51-4d1b-9a1e-0a0000000204",
      "name": "Mark delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/v1/review-requests/' + $('Claim review requests').item.json.id + '/delivered' }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
  "connections": {
    "Every 10 seconds": {
      "main": [
        [
          {
            "node": "Claim review requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim review requests": {
      "main": [
        [
          {
            "node": "Ask for a review",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Ask for a review": {
      "main": [
        [
          {
            "node": "Mark delivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "P01W3AlertMail00",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false
}
